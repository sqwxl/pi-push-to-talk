#!/bin/sh
# Serve this machine's microphone on loopback for a remote pi.
#
# SSH starts this on a connection whose host config forwards 17777 back here.
# One recorder runs per connection, so the microphone is open only while pi
# records. A later SSH session finds the port taken and leaves the listener
# alone, which is why no cleanup is needed when an SSH process exits.
set -eu

port=17777

if command -v parec >/dev/null 2>&1; then
	recorder='parec --raw --rate=16000 --channels=1 --format=s16le --latency-msec=20'
elif command -v ffmpeg >/dev/null 2>&1; then
	recorder='ffmpeg -hide_banner -loglevel error -f avfoundation -i :0 -ar 16000 -ac 1 -f s16le -'
else
	# No recorder: leave the port closed so pi uses the remote device instead.
	exit 0
fi

command -v socat >/dev/null 2>&1 || exit 0

# Fails quietly when another SSH session already serves the port.
exec socat TCP-LISTEN:"${port}",bind=127.0.0.1,reuseaddr,fork EXEC:"${recorder}" >/dev/null 2>&1
