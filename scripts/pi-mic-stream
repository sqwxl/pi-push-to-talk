#!/bin/sh
# Serve this machine's microphone on loopback for a remote pi.
#
# Started by SSH on a connection whose host config forwards a port back here,
# or by the setup script. One recorder runs per connection, so the microphone
# is open only while pi records. A later SSH session finds the port taken and
# leaves the listener alone, which is why no cleanup is needed on disconnect.
#
# Each connection starts with one `pi-mic <host>` line, then 16 kHz mono
# signed 16-bit little-endian PCM. The listening port here is always 17777;
# the port on the far side of the forward is the one that varies.
#
# With a host argument the helper also makes sure its session owns a port: the
# static RemoteForward can be refused when a stale session still holds the
# port, and only a new request can recover. It asks the SSH master that owns
# this connection for the first free port in the range.
set -eu

port=17777
range_first=47777
range_last=47792

if [ "${1:-}" = "--serve" ]; then
	printf 'pi-mic %s\n' "$(hostname -s 2>/dev/null || hostname)"
	if command -v parec >/dev/null 2>&1; then
		exec parec --raw --rate=16000 --channels=1 --format=s16le --latency-msec=20
	fi
	exec ffmpeg -hide_banner -loglevel error -f avfoundation -i :0 -ar 16000 -ac 1 -f s16le -
fi

host="${1:-}"

if ! command -v parec >/dev/null 2>&1 && ! command -v ffmpeg >/dev/null 2>&1; then
	# No recorder: leave the port closed so pi uses another source.
	exit 0
fi
command -v socat >/dev/null 2>&1 || exit 0

# Ask the connection that started us for a port it can bind. Without a control
# socket (a plain one-off ssh) the static RemoteForward is all there is.
negotiate() {
	control=""
	# A master for another host answers -O check just as happily, so match the
	# host in the command line of the process that owns the socket.
	for socket in /tmp/hssh-*/*; do
		[ -S "$socket" ] || continue
		# The client command line holds the ControlPath pattern, not the
		# expanded name, so match its prefix before the final hash.
		prefix="${socket%-*}"
		if ps -eo args= 2>/dev/null | grep -F -- "-S $prefix" | grep -Fq -- " $1"; then
			control="$socket"
			break
		fi
	done
	[ -n "$control" ] || return 0

	# Ask for this client's own port first: the static forward in the ssh config
	# already made it, and asking again is a no-op. Only a refusal, which means a
	# stale session holds it, sends the search onwards.
	preferred=$(cat "$HOME/.local/bin/pi-mic-stream.port" 2>/dev/null || echo "$range_first")
	if ssh -S "$control" -O forward -R "127.0.0.1:$preferred:127.0.0.1:$port" "$1" >/dev/null 2>&1; then
		return 0
	fi

	candidate=$range_first
	while [ "$candidate" -le "$range_last" ]; do
		if [ "$candidate" = "$preferred" ]; then
			candidate=$((candidate + 1))
			continue
		fi
		if ssh -S "$control" -O forward -R "127.0.0.1:$candidate:127.0.0.1:$port" "$1" >/dev/null 2>&1; then
			return 0
		fi
		candidate=$((candidate + 1))
	done
}
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# Fails quietly when another SSH session already serves the port.
socat TCP-LISTEN:"${port}",bind=127.0.0.1,reuseaddr,fork EXEC:"${self} --serve" >/dev/null 2>&1 &
child=$!
trap 'kill "$child" 2>/dev/null' EXIT INT TERM

if [ -n "$host" ]; then
	negotiate "$host"
fi

wait "$child"
