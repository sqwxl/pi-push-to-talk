    "pi-extension",
    "dictation",
    "push-to-talk",
    "speech-to-text",
    "whisper",
    "local"
  ],
  "license": "MIT",
  "author": "sqwxl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqwxl/pi-push-to-talk.git"
  },
  "homepage": "https://github.com/sqwxl/pi-push-to-talk#readme",
  "bugs": {
    "url": "https://github.com/sqwxl/pi-push-to-talk/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
